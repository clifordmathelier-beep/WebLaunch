---
import { SITE } from '@consts';

const bookingUrl = SITE.BOOKING_PORTAL_URL ?? '#';
const telHref = `tel:${SITE.TELEPHONE.replace(/\D/g, '')}`;
---

<section id="contact" class="contact">
  <div class="section-container contact-inner">
    <div class="contact-layout">
      <div class="contact-column contact-column--info">
        <h1 class="contact-page-title">Get in Touch</h1>
        <p class="contact-intro">
          We are currently accepting new clients for parent consultations. For therapy
          availability or general inquiries, please use the contact form or reach out
          directly.
        </p>

        <ul class="contact-methods">
          <li class="contact-method">
            <div class="contact-method-icon contact-method-icon--email" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-method-svg">
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <path d="m2 7 10 7 10-7"></path>
              </svg>
            </div>
            <div class="contact-method-body">
              <span class="contact-method-label">Email us</span>
              <a href={`mailto:${SITE.EMAIL}`} class="contact-method-value">{SITE.EMAIL}</a>
            </div>
          </li>

          <li class="contact-method">
            <div class="contact-method-icon contact-method-icon--phone" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-method-svg">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="contact-method-body">
              <span class="contact-method-label">Phone</span>
              <a href={telHref} class="contact-method-value">{SITE.TELEPHONE}</a>
            </div>
          </li>

          <li class="contact-method">
            <div class="contact-method-icon contact-method-icon--portal" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="contact-method-svg">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
              </svg>
            </div>
            <div class="contact-method-body">
              <span class="contact-method-label">Secure portal</span>
              <a
                href={bookingUrl}
                class="contact-method-value contact-method-value--link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Book via Simple Practice
              </a>
            </div>
          </li>
        </ul>
      </div>

      <div class="contact-column contact-column--form">
        <form class="contact-form contact-form-card" action="">
          <h2 class="contact-form-title">Send an Inquiry</h2>

          <div class="contact-form-grid">
            <div class="form-field">
              <label class="visually-hidden" for="firstName">First name</label>
              <input
                class="form-input"
                id="firstName"
                name="firstName"
                type="text"
                autocomplete="given-name"
                placeholder="First name"
                required
              />
            </div>
            <div class="form-field">
              <label class="visually-hidden" for="lastName">Last name</label>
              <input
                class="form-input"
                id="lastName"
                name="lastName"
                type="text"
                autocomplete="family-name"
                placeholder="Last name"
                required
              />
            </div>
            <div class="form-field form-field--full">
              <label class="visually-hidden" for="email">Email address</label>
              <input
                class="form-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="Email address"
                required
              />
            </div>
            <div class="form-field form-field--full">
              <label class="visually-hidden" for="message">Message</label>
              <textarea
                class="form-input form-textarea"
                id="message"
                name="message"
                rows="7"
                placeholder="How can we help?"
                required></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn--primary contact-submit">Send message</button>

          <p class="contact-terms">
            <span class="contact-terms-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
              </svg>
            </span>
            All fields are required. By sending the form you agree to the
            <a class="text-link" href="/legal/terms">Terms &amp; Conditions</a> and
            <a class="text-link" href="/legal/privacy">Privacy Policy</a>.
          </p>

          <div id="form-feedback" class="form-feedback" hidden>
            <p>Thank you! Your message has been sent.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-background);
  }

  .contact-inner {
    max-width: 75rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--px-64);
    align-items: start;
  }

  .contact-page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 600;
    color: #1a435b;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--px-24);
  }

  .contact-intro {
    margin: 0 0 var(--px-40);
    max-width: 28rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.65;
    color: #6b7280;
  }

  .contact-methods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--px-32);
  }

  .contact-method {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--px-16);
    align-items: start;
  }

  .contact-method-icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a435b;
    flex-shrink: 0;
  }

  .contact-method-icon--email {
    background-color: #fde8e0;
  }

  .contact-method-icon--phone {
    background-color: #e6f4f1;
  }

  .contact-method-icon--portal {
    background-color: #ede4f5;
  }

  .contact-method-svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .contact-method-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #607d8b;
    margin-bottom: var(--px-6);
  }

  .contact-method-value {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #1a435b;
    text-decoration: none;
    transition: opacity var(--transition-short);
  }

  .contact-method-value--link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contact-form-card {
    margin: 0;
    background-color: #ffffff;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(26, 67, 91, 0.08), 0 2px 8px rgba(26, 67, 91, 0.04);
    padding: var(--px-40) var(--px-40) var(--px-36);
    border: 1px solid rgba(26, 54, 91, 0.06);
  }

  :global([data-theme="dark"]) .contact-form-card {
    background-color: var(--color-bg-secondary);
    border-color: var(--color-border);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
  }

  .contact-form-title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 600;
    color: #1a435b;
    margin: 0 0 var(--px-28);
    letter-spacing: -0.02em;
  }

  :global([data-theme="dark"]) .contact-page-title,
  :global([data-theme="dark"]) .contact-form-title,
  :global([data-theme="dark"]) .contact-method-value {
    color: var(--color-text-primary);
  }

  :global([data-theme="dark"]) .contact-intro,
  :global([data-theme="dark"]) .contact-method-label {
    color: var(--color-text-secondary);
  }

  :global([data-theme="dark"]) .contact-method-icon {
    color: var(--color-text-primary);
  }

  .contact-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-16);
    margin-bottom: var(--px-24);
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: #1a435b;
    background-color: #ffffff;
    padding: var(--px-14) var(--px-16);
    border: 1px solid rgba(96, 125, 139, 0.28);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--transition-short),
      box-shadow var(--transition-short);
  }

  :global([data-theme="dark"]) .form-input {
    background-color: var(--color-background);
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .form-input::placeholder {
    color: #9ca3af;
  }

  .form-input:focus {
    outline: none;
    border-color: rgba(26, 67, 91, 0.45);
    box-shadow: 0 0 0 3px rgba(26, 67, 91, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 10rem;
    line-height: 1.5;
  }

  .contact-submit {
    width: 100%;
    margin-bottom: var(--px-20);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    box-shadow: 0 4px 14px rgba(26, 67, 94, 0.2);
  }

  .contact-terms {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--px-6);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: #6b7280;
    margin: 0;
  }

  :global([data-theme="dark"]) .contact-terms {
    color: var(--color-text-secondary);
  }

  .contact-terms-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: #607d8b;
  }

  .contact-terms-icon svg {
    display: block;
  }

  .form-feedback {
    margin-top: var(--px-16);
    color: #1b6b3a;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  :global([data-theme="dark"]) .form-feedback {
    color: #7fd4a8;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-method-value:hover {
      opacity: 0.85;
    }

    .form-input:hover {
      border-color: rgba(96, 125, 139, 0.45);
    }
  }

  @media screen and (max-width: 59.375rem) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--px-48);
    }

    .contact-form-card {
      padding: var(--px-28);
    }
  }

  @media screen and (max-width: 40rem) {
    .contact-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelector('.contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const feedback = document.getElementById('form-feedback');
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!feedback || !submitButton) return;

    submitButton.disabled = true;
    const originalText = submitButton.textContent;
    submitButton.textContent = 'Sending...';

    await new Promise((resolve) => setTimeout(resolve, 1500));

    feedback.hidden = false;

    form.reset();
    submitButton.textContent = originalText;
    submitButton.disabled = false;

    setTimeout(() => {
      feedback.hidden = true;
    }, 4000);
  });
</script>
