---
import { SITE } from "@consts";

const newClientUrl = SITE.NEW_CLIENT_INTAKE_URL;
const existingClientUrl = SITE.EXISTING_CLIENT_PORTAL_URL;
const telHref = `tel:${SITE.TELEPHONE.replace(/\D/g, "")}`;
---

<section id="contact" class="contact">
  <div class="section-container contact-inner">
    <h1 class="contact-page-title">Contact</h1>
    <p class="contact-intro">
      I am currently accepting new clients for parent consultations and for
      parent-only therapy. Choose the option that fits your situation — both
      links open Simple Practice.
    </p>

    <div class="contact-paths">
      <article id="new-clients" class="contact-path">
        <h2 class="contact-path-title">New Clients</h2>
        <p class="contact-path-body">
          Interested in scheduling a brief phone consultation to see if we
          may be a good fit? Please complete the new client request form.
        </p>
        <a
          href={newClientUrl}
          class="btn btn--primary contact-path-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          New or interested clients — click here
        </a>
      </article>

      <article id="existing-clients" class="contact-path">
        <h2 class="contact-path-title">Existing Clients</h2>
        <p class="contact-path-body">
          Already working with me? Use the client portal to message, manage
          appointments, and complete paperwork.
        </p>
        <a
          href={existingClientUrl}
          class="btn btn--primary contact-path-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Existing clients — click here
        </a>
      </article>
    </div>

    <div class="contact-phone-row">
      <span class="contact-phone-label">Phone</span>
      <a href={telHref} class="contact-phone-value">{SITE.TELEPHONE}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-background);
  }

  .contact-inner {
    max-width: 48rem;
  }

  .contact-page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 600;
    color: #1a435b;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--px-24);
  }

  .contact-intro {
    margin: 0 0 var(--px-40);
    max-width: 40rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.65;
    color: #6b7280;
  }

  .contact-paths {
    display: flex;
    flex-direction: column;
    gap: var(--px-32);
    margin-bottom: var(--px-48);
  }

  .contact-path {
    padding: var(--px-28);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
  }

  .contact-path-title {
    margin: 0 0 var(--px-12);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: #1a435b;
  }

  .contact-path-body {
    margin: 0 0 var(--px-20);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.6;
    color: #334e5c;
  }

  .contact-path-cta {
    display: inline-flex;
    text-align: center;
    transition: none !important;
    transform: none !important;
  }

  .contact-path-cta::before,
  .contact-path-cta::after {
    content: none !important;
    display: none !important;
  }

  .contact-path-cta:hover,
  .contact-path-cta:focus,
  .contact-path-cta:active {
    background-color: var(--color-primary) !important;
    color: var(--color-white) !important;
    filter: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  .contact-phone-row {
    display: flex;
    flex-direction: column;
    gap: var(--px-6);
    padding-top: var(--px-8);
  }

  .contact-phone-label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #607d8b;
  }

  .contact-phone-value {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #1a435b;
    text-decoration: none;
    transition: opacity var(--transition-short);
  }

  :global([data-theme="dark"]) .contact-page-title,
  :global([data-theme="dark"]) .contact-path-title,
  :global([data-theme="dark"]) .contact-phone-value {
    color: var(--color-text-primary);
  }

  :global([data-theme="dark"]) .contact-intro,
  :global([data-theme="dark"]) .contact-phone-label,
  :global([data-theme="dark"]) .contact-path-body {
    color: var(--color-text-secondary);
  }

  :global([data-theme="dark"]) .contact-path {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-phone-value:hover {
      opacity: 0.85;
    }
  }
</style>
