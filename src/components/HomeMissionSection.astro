---
const missionBody =
    "Multi-Clarity and Awareness LLC provides a single point of reference for parents seeking to resolve the dilemmas of childhood. We prioritize evidence-based strategies delivered with the empathy of a partner in your parenting journey.";
---

<section class="home-mission" aria-labelledby="home-mission-heading">
    <div class="section-container home-mission__inner">
        <div class="home-mission__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
        </div>
        <h2 id="home-mission-heading" class="home-mission__title">
            Compassionate approach. Clinical expertise.
        </h2>
        <p class="home-mission__body">{missionBody}</p>
        <a href="/Services" class="home-mission__cta">
            Learn about our services
            <span class="home-mission__cta-chevron" aria-hidden="true">&gt;</span>
        </a>
    </div>
</section>

<style>
    .home-mission {
        background-color: var(--color-background);
        padding-block: var(--px-96) var(--px-112);
        padding-inline: var(--px-24);
    }

    .home-mission__inner {
        max-width: 46rem;
        margin-inline: auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .home-mission__icon {
        color: #f8b195;
        width: 2rem;
        height: 2rem;
        margin-bottom: var(--px-24);
    }

    .home-mission__icon svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .home-mission__title {
        margin: 0 0 var(--px-28);
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.75rem, 3.8vw, 2.375rem);
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #1a435b;
    }

    .home-mission__body {
        margin: 0 0 var(--px-32);
        font-family: var(--font-sans);
        font-size: clamp(var(--text-base), 1.4vw, var(--text-lg));
        line-height: 1.65;
        color: #334e5c;
        max-width: 40rem;
    }

    .home-mission__cta {
        display: inline-flex;
        align-items: center;
        gap: var(--px-8);
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        color: #1a435b;
        transition: color var(--transition-short);
    }

    .home-mission__cta-chevron {
        font-weight: 500;
        letter-spacing: 0;
    }

    :global([data-theme="dark"]) .home-mission {
        background-color: var(--color-background);
    }

    :global([data-theme="dark"]) .home-mission__title {
        color: var(--color-text-primary);
    }

    :global([data-theme="dark"]) .home-mission__body {
        color: var(--color-text-secondary);
    }

    :global([data-theme="dark"]) .home-mission__cta {
        color: var(--color-text-primary);
    }

    @media (hover: hover) and (pointer: fine) {
        .home-mission__cta:hover {
            color: #e9967a;
        }
    }
</style>
