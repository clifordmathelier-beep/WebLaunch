---
const pathNorm =
    Astro.url.pathname.replace(/\/$/, "") === ""
        ? "/"
        : Astro.url.pathname.replace(/\/$/, "");
const pathLower = pathNorm.toLowerCase();
const homeActive = pathNorm === "/";
const servicesActive = pathLower.startsWith("/services");
const bioActive = pathLower === "/bio";
const faqActive = pathLower === "/faq";
const contactActive = pathLower === "/contact";
---

<header id="header" class="header">
    <div class="mobile-overlay"></div>
    <nav
        class="section-container nav-container"
        role="navigation"
        aria-label="Main navigation"
    >
        <div class="logo-container">
            <a
                href="/"
                class="logo-lockup"
                aria-label="Multi-Clarity and Awareness LLC home"
            >
                <span class="logo-mark" aria-hidden="true">
                    <svg
                        class="logo-mark-svg"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 48 48"
                        width="48"
                        height="48"
                        fill="none"
                    >
                        <circle cx="24" cy="24" r="22" fill="#F8B195" />
                        <circle
                            cx="24"
                            cy="24"
                            r="11.5"
                            stroke="#ffffff"
                            stroke-width="1.35"
                        />
                        <polygon
                            fill="#ffffff"
                            points="24,12.5 29.2,24 24,35.5 18.8,24"
                            transform="rotate(18 24 24)"
                        />
                    </svg>
                </span>
                <span class="logo-text">
                    <span class="logo-wordmark">Multi-Clarity</span>
                    <span class="logo-tagline">and awareness llc</span>
                </span>
            </a>
        </div>

        <div class="nav-content">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a
                        href="/"
                        class:list={["nav-link", { "nav-link--active": homeActive }]}
                        aria-current={homeActive ? "page" : undefined}
                    >
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Bio" class:list={["nav-link", { "nav-link--active": bioActive }]}
                        aria-current={bioActive ? "page" : undefined}
                    >
                        Bio
                    </a>
                </li>

                <li class="nav-item">
                    <a
                        href="/Services"
                        class:list={[
                            "nav-link",
                            { "nav-link--active": servicesActive },
                        ]}
                        aria-current={servicesActive ? "page" : undefined}
                    >
                        Services
                    </a>
                </li>

                <li class="nav-item">
                    <a
                        href="/FAQ"
                        class:list={["nav-link", { "nav-link--active": faqActive }]}
                        aria-current={faqActive ? "page" : undefined}
                    >
                        FAQ
                    </a>
                </li>

                <li class="nav-item">
                    <a
                        href="/Contact"
                        class:list={[
                            "nav-link",
                            { "nav-link--active": contactActive },
                        ]}
                        aria-current={contactActive ? "page" : undefined}
                    >
                        Contact
                    </a>
                </li>
            </ul>

            <a href="/Contact" class="btn btn--primary mobile-cta">Intake Form</a>
        </div>

        <!-- Theme toggle -->
        <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle dark mode"
            aria-pressed="false"
        >
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
        </button>

        <!-- Desktop CTA -->
        <a href="/Contact" class="btn btn--primary desktop-cta">
            Intake Form
        </a>

        <button
            class="hamburger"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </nav>
</header>

<div id="trigger" class="trigger"></div>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--h-menu-bar);
        display: flex;
        padding-inline: var(--px-32);
        z-index: var(--z-max);
        transition: all var(--transition-short);
    }

    .nav-container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: var(--text-base);
        font-weight: 500;
        color: var(--color-header-text, var(--color-text-primary));
    }

    .logo-container {
        flex-shrink: 0;
    }

    .logo-lockup {
        display: flex;
        align-items: center;
        gap: var(--px-12);
        text-decoration: none;
        color: inherit;
    }

    .logo-mark {
        display: flex;
        flex-shrink: 0;
    }

    .logo-mark-svg {
        display: block;
        width: clamp(2.5rem, 5vw, 3rem);
        height: clamp(2.5rem, 5vw, 3rem);
    }

    .logo-text {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        line-height: 1.05;
        min-width: 0;
    }

    .logo-wordmark {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
        letter-spacing: -0.02em;
        color: #1a435b;
    }

    .logo-tagline {
        font-family: var(--font-sans);
        font-size: clamp(0.5625rem, 1.15vw, 0.6875rem);
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #607d8b;
    }

    :global([data-theme="dark"]) .logo-wordmark {
        color: var(--color-text-primary);
    }

    :global([data-theme="dark"]) .logo-tagline {
        color: var(--color-text-secondary);
    }

    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: var(--px-28);
        height: var(--px-18);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: var(--z-max);
    }

    .hamburger-line {
        display: block;
        width: 100%;
        height: var(--px-2);
        background-color: currentColor;
        transition: transform var(--transition-medium);
    }

    .nav-menu {
        display: flex;
    }

    .nav-item {
        margin-inline: var(--px-16);
    }

    .nav-menu .nav-link {
        position: relative;
        display: inline-flex;
        justify-content: center;
        padding-bottom: 0.625rem;
        color: #334e5c;
        font-weight: 600;
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: color var(--transition-short);
    }

    .nav-menu .nav-link::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: calc(100% + 0.5rem);
        height: 0.25rem;
        background-color: #e9967a;
        transform: translateX(-50%) scaleX(0);
        transform-origin: center;
        transition: transform var(--transition-short);
    }

    .nav-menu .nav-link--active::after {
        transform: translateX(-50%) scaleX(1);
    }

    .nav-menu .nav-link:focus-visible::after {
        transform: translateX(-50%) scaleX(1);
    }

    .nav-menu .nav-link:active {
        transform: scale(0.98);
    }

    :global([data-theme="dark"]) .nav-menu .nav-link {
        color: var(--color-text-primary);
    }

    :global([data-theme="dark"]) .nav-menu .nav-link::after {
        background-color: #e9967a;
    }

    .desktop-cta {
        display: inline-flex;
        flex-shrink: 0;
    }

    .mobile-cta {
        display: none;
    }

    .scrolled {
        height: var(--h-menu-bar-scrolled) !important;
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, #ffffff 88%, var(--color-background) 12%);
        box-shadow: var(--shadow-header);
    }

    :global([data-theme="dark"]) .scrolled {
        background: color-mix(in srgb, var(--color-bg-secondary) 92%, transparent);
    }

    .mobile-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--color-overlay);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: var(--z-50);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .trigger {
        height: 1px;
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--px-36);
        height: var(--px-36);
        background: none;
        border: none;
        cursor: pointer;
        opacity: 0.65;
        transition: opacity var(--transition-short);
        flex-shrink: 0;
    }

    .theme-toggle:hover {
        opacity: 1;
    }

    .theme-toggle svg {
        width: var(--px-20);
        height: var(--px-20);
        position: absolute;
        transition: opacity var(--transition-medium), transform var(--transition-medium);
    }

    /* Light mode: show sun, hide moon */
    :global([data-theme="light"]) .icon-sun  { opacity: 1; transform: rotate(0deg) scale(1); }
    :global([data-theme="light"]) .icon-moon { opacity: 0; transform: rotate(90deg) scale(0.5); }

    /* Dark mode: hide sun, show moon */
    :global([data-theme="dark"]) .icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.5); }
    :global([data-theme="dark"]) .icon-moon { opacity: 1; transform: rotate(0deg) scale(1); }

    @media (hover: hover) and (pointer: fine) {
        .nav-menu .nav-link:hover::after {
            transform: translateX(-50%) scaleX(1);
        }
    }

    @media screen and (max-width: 64rem) {
        .header {
            padding-inline: var(--px-16);
        }

        .desktop-cta {
            display: none;
        }

        .mobile-cta {
            display: inline-flex;
            font-size: var(--text-sm);
            justify-content: center;
        }

        .hamburger {
            display: flex;
        }

        .nav-content {
            z-index: var(--z-999);
            position: fixed;
            top: 0;
            right: -100%;
            height: 100vh;
            width: 100%;
            max-width: 18.75rem;
            background: var(--color-background);
            flex-direction: column;
            padding: calc(var(--h-menu-bar) + 2rem) var(--px-16) var(--px-32);
            transition: right 0.3s ease;
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            justify-content: flex-start;
        }

        .nav-content.active {
            right: 0;
        }

        .nav-menu {
            flex-direction: column;
            gap: var(--px-20);
            margin-bottom: var(--px-40);
            justify-content: flex-start;
        }

        .nav-item {
            margin: 0;
        }

        .nav-menu .nav-link {
            font-size: var(--text-2xl);
            padding-bottom: var(--px-16);
        }

        .nav-menu .nav-link::after {
            height: 0.3125rem;
            width: calc(100% + 0.75rem);
        }

        .hamburger.active .hamburger-line:nth-child(1) {
            transform: translateY(0.438rem) rotate(45deg);
        }

        .hamburger.active .hamburger-line:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active .hamburger-line:nth-child(3) {
            transform: translateY(-0.563rem) rotate(-45deg);
        }
    }
</style>

<script>
    function observeHeader() {
        const trigger = document.getElementById("trigger");
        const header = document.getElementById("header");

        if (!trigger || !header) return;

        const observer = new IntersectionObserver(
            ([entry]) => {
                header.classList.toggle("scrolled", !entry.isIntersecting);
            },
            { threshold: 0 },
        );

        observer.observe(trigger);

        return () => observer.disconnect();
    }

    function initMobileMenu() {
        const hamburger = document.querySelector(".hamburger");
        const navContent = document.querySelector(".nav-content");
        const overlay = document.querySelector(".mobile-overlay");

        if (!hamburger || !navContent || !overlay) return;

        function closeMenu() {
            hamburger?.classList.remove("active");
            navContent?.classList.remove("active");
            overlay?.classList.remove("active");
            hamburger?.setAttribute("aria-expanded", "false");
            document.body.classList.remove("no-scroll");
        }

        function openMenu() {
            hamburger?.classList.add("active");
            navContent?.classList.add("active");
            overlay?.classList.add("active");
            hamburger?.setAttribute("aria-expanded", "true");
            document.body.classList.add("no-scroll");
        }

        const toggleMenu = () => {
            hamburger.classList.contains("active") ? closeMenu() : openMenu();
        };

        const handleEscape = (e: KeyboardEvent) => {
            if (e.key === "Escape" && hamburger.classList.contains("active")) {
                closeMenu();
            }
        };

        // Event delegation for nav links
        navContent.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target.closest(".nav-link") || target.closest(".mobile-cta")) {
                closeMenu();
            }
        });

        hamburger.addEventListener("click", toggleMenu);
        overlay.addEventListener("click", closeMenu);
        document.addEventListener("keydown", handleEscape);

        return () => {
            hamburger.removeEventListener("click", toggleMenu);
            navContent.removeEventListener("click", closeMenu);
            overlay.removeEventListener("click", closeMenu);
            document.removeEventListener("keydown", handleEscape);
        };
    }

    function initThemeToggle() {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;

        const applyTheme = (theme: string) => {
            document.documentElement.setAttribute("data-theme", theme);
            btn.setAttribute("aria-pressed", String(theme === "dark"));
            localStorage.setItem("theme", theme);
        };

        // Sync button state with current theme on each page load
        const current = document.documentElement.getAttribute("data-theme") ?? "light";
        btn.setAttribute("aria-pressed", String(current === "dark"));

        const handleClick = () => {
            const isDark = document.documentElement.getAttribute("data-theme") === "dark";
            applyTheme(isDark ? "light" : "dark");
        };

        btn.addEventListener("click", handleClick);
        return () => btn.removeEventListener("click", handleClick);
    }

    let headerCleanup = observeHeader();
    let menuCleanup = initMobileMenu();
    let themeCleanup = initThemeToggle();

    document.addEventListener("astro:after-swap", () => {
        if (headerCleanup) headerCleanup();
        if (menuCleanup) menuCleanup();
        if (themeCleanup) themeCleanup();
        headerCleanup = observeHeader();
        menuCleanup = initMobileMenu();
        themeCleanup = initThemeToggle();
    });
</script>
