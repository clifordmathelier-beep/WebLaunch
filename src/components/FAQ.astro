---
const faqItems = [
  {
    id: 1,
    question: 'Do you accept insurance?',
    answer:
      'I am not contracted with any insurance company at this time. Payment is required at the time of service. Parent consultation sessions are only eligible for insurance reimbursement if you already have a diagnosis. Diagnostic evaluations and therapy sessions may be eligible for insurance reimbursement if you have out-of-network benefits through your insurance carrier. I will provide you with a detailed receipt including diagnosis and session codes to submit to your insurance carrier to assist with reimbursement. Families who wish to utilize insurance benefits should ensure they understand their out-of-network benefits before beginning treatment.',
  },
  {
    id: 2,
    question: 'Do you meet in person or via telehealth?',
    answer:
      'At this time, all sessions are available virtually, via secure telehealth, as long as you are located in a state where I am currently licensed (Florida, Massachusetts, and PSYPACT states).',
  },
  {
    id: 3,
    question: 'How do I get started?',
    answer:
      'Visit the Contact page and use the new client link to complete the Simple Practice request form, or call the number listed there. We\'ll find a time for a brief phone call and take it from there.',
  },
];
---

<section id="faq" class="faq">
  <div class="section-container faq-container">
    <header class="faq-header">
      <h1 class="section-title faq-title">FAQ</h1>
    </header>

    <div class="faq-content">
      <div class="accordion">
        {
          faqItems.map((item) => {
            const triggerId = `faq-trigger-${item.id}`;
            const panelId = `faq-panel-${item.id}`;
            return (
              <div class="accordion-item">
                <button
                  type="button"
                  class="accordion-button"
                  id={triggerId}
                  aria-expanded="false"
                  aria-controls={panelId}
                >
                  <span class="button-text">{item.question}</span>
                  <svg
                    class="button-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </button>
                <div
                  class="accordion-content"
                  id={panelId}
                  role="region"
                  aria-labelledby={triggerId}
                  aria-hidden="true"
                >
                  <div class="content-wrapper">
                    <p>{item.answer}</p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-container {
    display: grid;
    grid-template-columns: minmax(10rem, 0.85fr) minmax(0, 1.15fr);
    gap: var(--px-64);
    align-items: start;
  }

  .faq-header {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--px-48);
  }

  .faq-title {
    text-align: center;
    margin: 0;
  }

  .accordion {
    display: flex;
    flex-direction: column;
  }

  .accordion-item {
    border-bottom: var(--px-1) solid var(--color-primary);
  }

  .accordion-button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--px-16);
    padding: var(--px-20) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-long);
  }

  .button-text {
    font-size: var(--text-xl);
    font-weight: 400;
    transition: all var(--transition-long);
  }

  .button-icon {
    width: var(--px-20);
    height: var(--px-20);
    transition: all var(--transition-long);
    flex-shrink: 0;
  }

  .accordion-item.active .button-text {
    font-weight: 500;
  }

  .accordion-item.active .button-icon {
    transform: rotate(45deg);
  }

  .accordion-content {
    height: 0;
    overflow: hidden;
    transition: height var(--transition-long);
  }

  .content-wrapper {
    padding-bottom: 0.813rem;
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--transition-long);
  }

  .content-wrapper p {
    margin: 0 0 var(--px-16);
    white-space: pre-line;
    line-height: 1.6;
  }

  .content-wrapper p:last-child {
    margin-bottom: 0;
  }

  .accordion-item.active .content-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .accordion-button:hover .button-text,
    .accordion-button:hover .button-icon {
      opacity: 0.65;
    }
  }

  @media (max-width: 64rem) {
    .faq-container {
      gap: var(--px-32);
    }
  }

  @media (max-width: 48rem) {
    .faq-container {
      grid-template-columns: 1fr;
      gap: var(--px-28);
    }

    .faq-header {
      padding-top: var(--px-16);
      justify-content: center;
    }
  }
</style>

<script>
  let faqAccordionAbort: AbortController | null = null;

  function initFAQAccordion() {
    faqAccordionAbort?.abort();
    const accordionContainer = document.querySelector(".faq-container");
    if (!accordionContainer) return;

    faqAccordionAbort = new AbortController();
    const { signal } = faqAccordionAbort;

    accordionContainer.addEventListener(
      "click",
      (e) => {
        const button = (e.target as HTMLElement).closest(".accordion-button");
        if (!button) return;

        const item = button.closest(".accordion-item");
        const content = item?.querySelector<HTMLElement>(".accordion-content");

        if (!item || !content) return;

        const isActive = item.classList.contains("active");

        document.querySelectorAll(".accordion-item.active").forEach((accItem) => {
          const accContent = accItem.querySelector<HTMLElement>(".accordion-content");
          const accButton = accItem.querySelector<HTMLButtonElement>(".accordion-button");

          if (!accContent || !accButton) return;

          if (accItem !== item) {
            accItem.classList.remove("active");
            accContent.style.height = "0";
            accButton.setAttribute("aria-expanded", "false");
            accContent.setAttribute("aria-hidden", "true");
          }
        });

        if (!isActive) {
          item.classList.add("active");
          content.style.height = `${content.scrollHeight}px`;
          button.setAttribute("aria-expanded", "true");
          content.setAttribute("aria-hidden", "false");
        } else {
          item.classList.remove("active");
          content.style.height = "0";
          button.setAttribute("aria-expanded", "false");
          content.setAttribute("aria-hidden", "true");
        }
      },
      { signal },
    );
  }

  initFAQAccordion();
  document.addEventListener("astro:after-swap", initFAQAccordion);
</script>
