---
import { Image } from "astro:assets";
import familyImage from "/src/assets/images/family1.jpg";
---
<section id="hero" class="hero">
    <div class="section-container hero-container">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="hero-title-line">Parenting with</span>
                <span class="hero-title-accent">Clarity.</span>
            </h1>
            <p class="hero-subtitle">
                Gain professional insight and compassionate support for your child's developmental path. Let's find confidence in the journey together.
            </p>
            <div class="hero-cta">
                <a href="/Contact" class="btn btn--primary hero-cta-primary">
                    Book a consultation
                    <span class="hero-cta-arrow" aria-hidden="true">→</span>
                </a>
                <a href="/Services" class="btn btn--outline hero-cta-secondary">
                    Our services
                </a>
            </div>
        </div>
        <div class="video-wrapper">
            <Image
                class="media"
                src={familyImage}
                alt="Happy family"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        padding-block: 6.688rem var(--px-56);
        display: flex;
        align-items: center;
    }

    .hero-container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: center;
    }

    .hero-content {
        max-width: 37.5rem;
    }

    .hero-title {
        margin-bottom: var(--px-28);
        line-height: 1.15;
    }

    .hero-title-line {
        display: block;
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(2rem, 4.2vw, 3rem);
        color: #1a435e;
        letter-spacing: -0.02em;
    }

    .hero-title-accent {
        display: block;
        margin-top: var(--px-4);
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 500;
        font-size: clamp(2.75rem, 8vw, 4.75rem);
        color: #f8b195;
        letter-spacing: -0.03em;
    }

    .hero-subtitle {
        font-family: var(--font-sans);
        font-size: clamp(var(--text-lg), 1.5vw, var(--text-xl));
        font-weight: 400;
        margin-bottom: var(--px-48);
        line-height: 1.6;
        color: #6b7280;
        opacity: 1;
    }

    .hero-cta-primary {
        text-transform: uppercase;
        letter-spacing: 0.06em;
        gap: var(--px-10);
        box-shadow: 0 4px 14px rgba(26, 67, 94, 0.22);
    }

    .hero-cta-arrow {
        font-size: 1.1em;
        line-height: 1;
        font-weight: 600;
    }

    .hero-cta-secondary {
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    :global([data-theme="dark"]) .hero-title-line {
        color: var(--color-text-primary);
    }

    :global([data-theme="dark"]) .hero-subtitle {
        color: var(--color-text-secondary);
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-48);
        flex-wrap: wrap;
    }

    .video-wrapper {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    @media screen and (max-width: 64rem) {
        .hero-container {
            gap: var(--px-32);
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            line-height: 1.2;
        }
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            min-height: auto;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .hero-title {
            margin-bottom: var(--px-24);
        }

        .hero-subtitle {
            margin-bottom: var(--px-36);
        }

        .hero-cta {
            column-gap: var(--px-32);
        }

        .video-wrapper {
            min-height: 18.75rem;
        }
    }
</style>
