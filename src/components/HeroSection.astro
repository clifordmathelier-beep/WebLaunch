---
---
<section id="hero" class="hero band-cream">
    <div class="section-container hero-container">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="hero-title-line">Parenting with</span>
                <span class="hero-title-accent">Clarity.</span>
            </h1>
            <p class="hero-subtitle">
                Gain professional insight and compassionate support for your child's developmental path. Let's find confidence in the journey together.
            </p>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: 8.5rem var(--px-56);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .hero-content {
        max-width: 44rem;
        width: 100%;
        text-align: center;
        margin-inline: auto;
    }

    .hero-title {
        margin-bottom: var(--px-28);
        line-height: 1.15;
    }

    .hero-title-line {
        display: block;
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(2rem, 4.2vw, 3rem);
        color: #1a435e;
        letter-spacing: -0.02em;
    }

    .hero-title-accent {
        display: block;
        margin-top: var(--px-4);
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 500;
        font-size: clamp(2.75rem, 8vw, 4.75rem);
        color: #f8b195;
        letter-spacing: -0.03em;
    }

    .hero-subtitle {
        font-family: var(--font-sans);
        font-size: clamp(var(--text-lg), 1.5vw, var(--text-xl));
        font-weight: 400;
        margin: 0 auto;
        max-width: 36rem;
        line-height: 1.6;
        color: #6b7280;
    }

    :global([data-theme="dark"]) .hero-title-line {
        color: var(--color-text-primary);
    }

    :global([data-theme="dark"]) .hero-subtitle {
        color: var(--color-text-secondary);
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            padding-block: 7.5rem var(--px-40);
        }

        .hero-title {
            margin-bottom: var(--px-24);
        }
    }
</style>
