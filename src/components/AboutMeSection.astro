---
import { Image } from 'astro:assets';
import headshotImage from '/src/assets/images/Tine_Headshot2.JPG';

const education = [
  {
    school: 'Williams College',
    detail: 'B.A. with Honors in Psychology and Spanish',
  },
  {
    school: 'Suffolk University',
    detail: 'Ph.D. in Clinical Psychology',
  },
  {
    school: 'Boston Children\'s Hospital, Harvard Medical School',
    detail: 'Predoctoral Internship in Pediatric Health Psychology',
  },
  {
    school: 'Boston Child Study Center',
    detail: 'Postdoctoral Fellowship in Clinical Psychology',
  },
];
---

<section id="about-me" class="about band-warm">
  <div class="section-container">
    <h2 class="section-title about-section-title">About Me</h2>
    <div class="about-container">
      <div class="about-image-wrapper">
        <Image
          src={headshotImage}
          alt="Marie-Christine André, PhD, clinical psychologist."
          class="media about-photo"
        />
      </div>
      <div class="about-content">
        <h3 class="section-subtitle about-name">Marie-Christine André, PhD</h3>
        <p class="about-text">
          I'm a licensed child clinical and pediatric psychologist with over 15 years of
          experience supporting children, adolescents, young adults and their parents. My
          work focuses on helping families find clarity and develop healthy coping skills to
          manage life transitions, mental health conditions, and medical diagnoses.
        </p>

        <h3 class="about-heading">Education</h3>
        <ul class="about-list" aria-label="Education">
          {education.map((item) => (
            <li class="about-list-item">
              <span class="about-list-dot" aria-hidden="true"></span>
              <span>
                <strong class="about-list-strong">{item.school}</strong>
                <span class="about-list-detail">{item.detail}</span>
              </span>
            </li>
          ))}
        </ul>

        <h3 class="about-heading">Licensed states</h3>
        <ul class="about-list" aria-label="Licensed states">
          <li class="about-list-item">
            <span class="about-list-dot" aria-hidden="true"></span>
            <span>Florida</span>
          </li>
          <li class="about-list-item">
            <span class="about-list-dot" aria-hidden="true"></span>
            <span>Massachusetts</span>
          </li>
          <li class="about-list-item">
            <span class="about-list-dot" aria-hidden="true"></span>
            <span>
              PSYPACT states —{' '}
              <a
                href="https://psypact.gov/page/psypactmap"
                class="about-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                click here
              </a>{' '}
              to see if your state is currently included in PSYPACT
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--px-80) var(--px-40);
  }

  .about-section-title {
    margin-bottom: var(--px-40);
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .about-image-wrapper {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .about-image-wrapper .about-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .about-content {
    max-width: 37.5rem;
  }

  .about-name {
    margin-bottom: var(--px-20);
  }

  .about-text {
    margin-bottom: var(--px-32);
    color: var(--color-text-dark);
  }

  .about-heading {
    margin: var(--px-28) 0 var(--px-16);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--px-12);
  }

  .about-list-item {
    display: flex;
    align-items: flex-start;
    gap: var(--px-12);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .about-list-dot {
    width: 6px;
    height: 6px;
    margin-top: 0.45em;
    border-radius: var(--radius-full);
    background-color: var(--color-focus);
    flex-shrink: 0;
  }

  .about-list-strong {
    display: block;
    color: var(--color-text-dark);
    font-weight: 600;
  }

  .about-list-detail {
    display: block;
  }

  .about-link {
    color: var(--color-focus);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      max-width: 22rem;
      order: -1;
    }
  }
</style>
