---
import BaseLayout from '@layouts/BaseLayout.astro';
import BioSection from '@components/BioSection.astro';
import { SITE } from '@consts';
---

<BaseLayout
  title={`${SITE.COMPANY_NAME}: Bio`}
  description="Meet your consultant and learn about clinical expertise in child development and multicultural family support."
>
  <div class="page-top-pad">
    <BioSection />
  </div>
</BaseLayout>

<style>
  .page-top-pad {
    padding-top: 10rem;
  }
</style>
